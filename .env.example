# 本地开发复制为 .env.local；生产安装器会生成权限为 600 的 .env.production。
DOMAIN=teacher.example.com

# 不要提交真实密钥。服务端也支持 OPENAI_API_KEY_FILE 指向 Docker/Kubernetes secret。
OPENAI_API_KEY=
# 使用文件型 Secret 时填写容器内路径，并通过 Compose override 或编排平台挂载该文件。
OPENAI_API_KEY_FILE=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6
OPENAI_REASONING_EFFORT=medium
OPENAI_IMAGE_DETAIL=high
OPENAI_MAX_OUTPUT_TOKENS=24000
AI_REQUEST_TIMEOUT_MS=180000

HOST=127.0.0.1
PORT=8787
MAX_BODY_BYTES=26214400
MAX_IMAGE_BYTES=8388608
MAX_PDF_BYTES=16777216
# 教材按文件暂存，不限制文件个数；以下容量限制用于防止单个账号耗尽服务器磁盘或模型上下文。
GENERATION_MAX_SOURCE_BYTES=67108864
MATERIAL_UPLOAD_TTL_SECONDS=86400
MATERIAL_UPLOAD_MAX_ACTIVE_BYTES=268435456

# 生产环境由安装器随机生成，不要沿用示例值。
SESSION_SECRET=replace-with-at-least-32-random-characters
SAFETY_ID_SALT=replace-with-a-different-32-character-random-value
# 生产安装器会生成并保留此值；40 位仅使用大小写字母、数字、- 和 _，不要公开。
ADMIN_ENTRY_PATH=/Aa0-Aa0-Aa0-Aa0-Aa0-Aa0-Aa0-Aa0-Aa0-Aa0-
ADMIN_ENTRY_TTL_SECONDS=28800
DATA_DIR=./data

# 账号、额度与会话。注册默认赠送 3 次生成额度；生产可按运营方案调整。
DEFAULT_FREE_CREDITS=3
USER_SESSION_TTL_SECONDS=604800
ADMIN_SESSION_TTL_SECONDS=28800

# 生产默认强制注册验证码；开发默认关闭以便离线开发。可显式覆盖。
REGISTRATION_VERIFICATION_REQUIRED=true
# 生产环境默认开启；创建新支付订单前验证当前绑定手机号或邮箱。幂等重试不重复消耗验证码。
PAYMENT_CHECKOUT_VERIFICATION_REQUIRED=true
VERIFICATION_CODE_TTL_SECONDS=300
VERIFICATION_CODE_RESEND_SECONDS=60
VERIFICATION_CODE_MAX_PER_HOUR=6
VERIFICATION_CODE_MAX_ATTEMPTS=5

# 登录与 AI 生成限流。多实例部署时应改用 Redis 等共享限流器。
AUTH_RATE_LIMIT_WINDOW_MS=600000
AUTH_RATE_LIMIT_IP_MAX=20
ADMIN_MFA_LOGIN_TTL_SECONDS=300
ADMIN_MFA_EMAIL_TTL_SECONDS=600
ADMIN_MFA_ENROLLMENT_TTL_SECONDS=600
ADMIN_MFA_MAX_ATTEMPTS=5
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_USER_MAX=6
AI_RATE_LIMIT_IP_MAX=20
AI_MAX_CONCURRENCY=4

# Caddy 反向代理场景为 true。仅信任由你控制的代理写入的转发头。
TRUST_PROXY=true

# 模型通道默认只允许公网 HTTPS，避免管理员配置造成 SSRF 或明文密钥传输。
ALLOW_INSECURE_PROVIDER_URLS=false
ALLOW_PRIVATE_PROVIDER_NETWORKS=false

# SMTP 凭据通过管理 API 加密保存；生产环境禁止明文 SMTP。
SMTP_TIMEOUT_MS=15000
ALLOW_INSECURE_SMTP=false

# 短信凭据不放在环境变量中：管理员登录后通过 /api/admin/communication/sms
# 配置阿里云短信或腾讯云短信，访问密钥会使用 SESSION_SECRET 加密落盘。
