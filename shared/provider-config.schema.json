{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.teacher-helper.local/provider-config.schema.json",
  "title": "教师帮 AI 服务商配置",
  "description": "管理员配置 OpenAI Responses、OpenAI Chat Completions 或自定义兼容服务时使用。配置中只允许保存密钥引用，不允许保存明文密钥。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "provider-config.v1"
    },
    "providerId": {
      "type": "string",
      "minLength": 1
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "enabled": {
      "type": "boolean"
    },
    "adapter": {
      "type": "string",
      "enum": [
        "openai_responses",
        "openai_chat",
        "custom"
      ]
    },
    "baseUrl": {
      "type": "string",
      "pattern": "^https://[^\\s]+$"
    },
    "apiVersion": {
      "type": "string"
    },
    "auth": {
      "$ref": "#/$defs/auth"
    },
    "endpoints": {
      "$ref": "#/$defs/endpoints"
    },
    "models": {
      "$ref": "#/$defs/models"
    },
    "capabilities": {
      "$ref": "#/$defs/capabilities"
    },
    "routing": {
      "$ref": "#/$defs/routing"
    },
    "limits": {
      "$ref": "#/$defs/limits"
    },
    "retryPolicy": {
      "$ref": "#/$defs/retryPolicy"
    },
    "circuitBreaker": {
      "$ref": "#/$defs/circuitBreaker"
    },
    "cost": {
      "$ref": "#/$defs/cost"
    },
    "privacy": {
      "$ref": "#/$defs/privacy"
    },
    "security": {
      "$ref": "#/$defs/security"
    },
    "healthCheck": {
      "$ref": "#/$defs/healthCheck"
    },
    "configVersion": {
      "type": "integer",
      "minimum": 1
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "updatedBy": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "providerId",
    "displayName",
    "enabled",
    "adapter",
    "baseUrl",
    "apiVersion",
    "auth",
    "endpoints",
    "models",
    "capabilities",
    "routing",
    "limits",
    "retryPolicy",
    "circuitBreaker",
    "cost",
    "privacy",
    "security",
    "healthCheck",
    "configVersion",
    "createdAt",
    "updatedAt",
    "updatedBy",
    "notes"
  ],
  "$defs": {
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "bearer",
            "api_key_header",
            "none"
          ]
        },
        "credentialRef": {
          "type": "string",
          "description": "密钥库引用，如 vault://providers/p1/api-key；不得填写明文密钥。"
        },
        "headerName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]*$"
        },
        "organizationId": {
          "type": "string"
        },
        "projectId": {
          "type": "string"
        },
        "keyLastFour": {
          "type": "string",
          "maxLength": 4
        }
      },
      "required": [
        "type",
        "credentialRef",
        "headerName",
        "organizationId",
        "projectId",
        "keyLastFour"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "none"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "credentialRef": {
                "maxLength": 0
              }
            }
          },
          "else": {
            "properties": {
              "credentialRef": {
                "pattern": "^(vault|secret)://[^\\s]+$"
              }
            }
          }
        }
      ]
    },
    "endpoints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "responsesPath": {
          "type": "string"
        },
        "chatCompletionsPath": {
          "type": "string"
        },
        "embeddingsPath": {
          "type": "string"
        },
        "moderationsPath": {
          "type": "string"
        }
      },
      "required": [
        "responsesPath",
        "chatCompletionsPath",
        "embeddingsPath",
        "moderationsPath"
      ]
    },
    "modelSlot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "modelId": {
          "type": "string"
        },
        "inputModalities": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "text",
              "image",
              "pdf"
            ]
          }
        },
        "outputModalities": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "text",
              "json",
              "embedding",
              "moderation"
            ]
          }
        },
        "contextWindowTokens": {
          "type": "integer",
          "minimum": 0
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "enabled",
        "modelId",
        "inputModalities",
        "outputModalities",
        "contextWindowTokens",
        "maxOutputTokens"
      ]
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vision": {
          "$ref": "#/$defs/modelSlot"
        },
        "generation": {
          "$ref": "#/$defs/modelSlot"
        },
        "revision": {
          "$ref": "#/$defs/modelSlot"
        },
        "grading": {
          "$ref": "#/$defs/modelSlot"
        },
        "embedding": {
          "$ref": "#/$defs/modelSlot"
        },
        "moderation": {
          "$ref": "#/$defs/modelSlot"
        }
      },
      "required": [
        "vision",
        "generation",
        "revision",
        "grading",
        "embedding",
        "moderation"
      ]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vision": {
          "type": "boolean"
        },
        "pdfInput": {
          "type": "boolean"
        },
        "structuredOutputs": {
          "type": "boolean"
        },
        "jsonSchema": {
          "type": "boolean"
        },
        "streaming": {
          "type": "boolean"
        },
        "embeddings": {
          "type": "boolean"
        },
        "moderation": {
          "type": "boolean"
        },
        "seed": {
          "type": "boolean"
        },
        "maxImagesPerRequest": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "vision",
        "pdfInput",
        "structuredOutputs",
        "jsonSchema",
        "streaming",
        "embeddings",
        "moderation",
        "seed",
        "maxImagesPerRequest"
      ]
    },
    "taskPriority": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "grading": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "embedding": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "moderation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      },
      "required": [
        "vision",
        "generation",
        "revision",
        "grading",
        "embedding",
        "moderation"
      ]
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "privacyClass": {
          "type": "string",
          "enum": [
            "self_hosted",
            "mainland_china",
            "approved_cross_border"
          ]
        },
        "taskPriority": {
          "$ref": "#/$defs/taskPriority"
        },
        "fallbackProviderIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requireSameOrStricterPrivacyClass": {
          "type": "boolean",
          "const": true
        },
        "allowedTenantIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "canaryWeightPercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "privacyClass",
        "taskPriority",
        "fallbackProviderIds",
        "requireSameOrStricterPrivacyClass",
        "allowedTenantIds",
        "canaryWeightPercent"
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "connectTimeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 120000
        },
        "requestTimeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 1800000
        },
        "maxConcurrency": {
          "type": "integer",
          "minimum": 1
        },
        "requestsPerMinute": {
          "type": "integer",
          "minimum": 0
        },
        "tokensPerMinute": {
          "type": "integer",
          "minimum": 0
        },
        "maxRequestBytes": {
          "type": "integer",
          "minimum": 1
        },
        "dailyBudget": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "connectTimeoutMs",
        "requestTimeoutMs",
        "maxConcurrency",
        "requestsPerMinute",
        "tokensPerMinute",
        "maxRequestBytes",
        "dailyBudget"
      ]
    },
    "retryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "baseDelayMs": {
          "type": "integer",
          "minimum": 0
        },
        "maxDelayMs": {
          "type": "integer",
          "minimum": 0
        },
        "jitter": {
          "type": "boolean"
        },
        "idempotentOnly": {
          "type": "boolean",
          "const": true
        },
        "retryStatusCodes": {
          "type": "array",
          "items": {
            "type": "integer",
            "enum": [
              408,
              409,
              429,
              500,
              502,
              503,
              504
            ]
          }
        }
      },
      "required": [
        "maxAttempts",
        "baseDelayMs",
        "maxDelayMs",
        "jitter",
        "idempotentOnly",
        "retryStatusCodes"
      ]
    },
    "circuitBreaker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "windowSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "cooldownSeconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "enabled",
        "failureThreshold",
        "windowSeconds",
        "cooldownSeconds"
      ]
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "currency": {
          "type": "string",
          "enum": [
            "CNY",
            "USD"
          ]
        },
        "inputPerMillionTokens": {
          "type": "number",
          "minimum": 0
        },
        "outputPerMillionTokens": {
          "type": "number",
          "minimum": 0
        },
        "perImage": {
          "type": "number",
          "minimum": 0
        },
        "embeddingPerMillionTokens": {
          "type": "number",
          "minimum": 0
        },
        "monthlyBudget": {
          "type": "number",
          "minimum": 0
        },
        "alertThresholdPercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "currency",
        "inputPerMillionTokens",
        "outputPerMillionTokens",
        "perImage",
        "embeddingPerMillionTokens",
        "monthlyBudget",
        "alertThresholdPercent"
      ]
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "processingRegion": {
          "type": "string",
          "minLength": 1
        },
        "dataResidency": {
          "type": "string",
          "enum": [
            "mainland_china",
            "approved_cross_border",
            "customer_controlled"
          ]
        },
        "providerTrainingUse": {
          "type": "string",
          "enum": [
            "not_used",
            "used",
            "unknown"
          ]
        },
        "retentionDays": {
          "type": "integer",
          "minimum": 0
        },
        "zeroDataRetention": {
          "type": "boolean"
        },
        "crossBorderTransfer": {
          "type": "boolean"
        },
        "sensitiveDataAllowed": {
          "type": "boolean"
        },
        "dpaVerified": {
          "type": "boolean"
        },
        "contractRef": {
          "type": "string"
        },
        "termsReviewedAt": {
          "type": "string"
        }
      },
      "required": [
        "processingRegion",
        "dataResidency",
        "providerTrainingUse",
        "retentionDays",
        "zeroDataRetention",
        "crossBorderTransfer",
        "sensitiveDataAllowed",
        "dpaVerified",
        "contractRef",
        "termsReviewedAt"
      ]
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tlsVerify": {
          "type": "boolean",
          "const": true
        },
        "allowedHostnames": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "blockPrivateNetworks": {
          "type": "boolean"
        },
        "allowPrivateNetwork": {
          "type": "boolean"
        },
        "certificatePinning": {
          "type": "boolean"
        },
        "secretRotationDays": {
          "type": "integer",
          "minimum": 1
        },
        "lastSecretRotationAt": {
          "type": "string"
        }
      },
      "required": [
        "tlsVerify",
        "allowedHostnames",
        "blockPrivateNetworks",
        "allowPrivateNetwork",
        "certificatePinning",
        "secretRotationDays",
        "lastSecretRotationAt"
      ]
    },
    "healthCheck": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "path": {
          "type": "string"
        },
        "method": {
          "type": "string",
          "enum": [
            "GET",
            "POST"
          ]
        },
        "expectedStatusCodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          }
        },
        "intervalSeconds": {
          "type": "integer",
          "minimum": 5
        },
        "unhealthyThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "lastCheckedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "unknown",
            "healthy",
            "degraded",
            "unhealthy",
            "disabled"
          ]
        }
      },
      "required": [
        "enabled",
        "path",
        "method",
        "expectedStatusCodes",
        "intervalSeconds",
        "unhealthyThreshold",
        "lastCheckedAt",
        "status"
      ]
    }
  }
}
